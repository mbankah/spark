<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- D3: lets Check Canvas see whether the Canvas app is installed. Nothing is read from it. -->
    <!-- A9: asked in the app with its reason, only when a proof photo is taken. In-app camera only; there is no gallery picker (A7). -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera.any" android:required="false" />
    <!-- A8, A9: location is read once, when a proof photo is taken, to check attendance. Never in the background. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <!-- The map for placing home and venues loads OpenStreetMap tiles. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- K2: the block list is chosen from the apps installed on this phone. -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" />
    <!-- LA11: the persistent Buffer notification. Asked in the app with its reason. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <queries><package android:name="com.instructure.candroid" /></queries>
    <application
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:allowBackup="false"
        android:theme="@android:style/Theme.Material.NoActionBar">
        <!-- Home app (U3, LA3): selectable as the default home. launchMode keeps one instance. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:stateNotNeeded="true"
            android:excludeFromRecents="false">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <!-- The card shown instead of a blocked app (U7, LA8, LA10). Not in recents, so back and home cannot loop. -->
        <activity
            android:name=".BlockedActivity"
            android:exported="false"
            android:launchMode="singleTask"
            android:excludeFromRecents="true"
            android:taskAffinity="app.efa.blocked"
            android:theme="@android:style/Theme.Material.NoActionBar" />
        <service
            android:name=".BlockerService"
            android:exported="true"
            android:label="Spark blocking"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter><action android:name="android.accessibilityservice.AccessibilityService" /></intent-filter>
            <meta-data android:name="android.accessibilityservice" android:resource="@xml/blocker_service" />
        </service>
        <!-- U8: holds notifications from blocked apps. Only the person can switch notification access on, in system settings. -->
        <service
            android:name=".NotifHolder"
            android:exported="true"
            android:label="Spark notifications"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter><action android:name="android.service.notification.NotificationListenerService" /></intent-filter>
        </service>
    </application>
</manifest>
